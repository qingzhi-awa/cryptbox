#!/bin/bash

### This script is called before the user upgrades the application.
### 升级前备份用户数据（var 目录在升级时由系统保留，此处额外做一份快照以防万一）。

if [ -n "${TRIM_PKGVAR}" ] && [ -f "${TRIM_PKGVAR}/passbook.db" ]; then
    BACKUP_DIR="${TRIM_PKGVAR}/backups"
    mkdir -p "${BACKUP_DIR}" 2>/dev/null
    if [ -d "${BACKUP_DIR}" ]; then
        STAMP=$(date +%Y%m%d%H%M%S)
        cp -f "${TRIM_PKGVAR}/passbook.db" "${BACKUP_DIR}/passbook.db.${TRIM_OLD_APPVER:-pre}.${STAMP}.bak" 2>/dev/null
        # 只保留最近 3 份备份
        ls -1t "${BACKUP_DIR}"/passbook.db.*.bak 2>/dev/null | tail -n +4 | xargs -r rm -f
    fi
fi

exit 0
