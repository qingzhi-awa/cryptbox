#!/bin/bash

### This script is called after the user uninstalls the application.
### 向导 wizard/uninstall 中的 wizard_delete_data=true 时清除用户数据。

DATA="${wizard_delete_data:-false}"

if [ "$DATA" = "true" ]; then
    # 删除主数据目录（数据库、日志等）
    if [ -n "${TRIM_PKGVAR}" ] && [ -d "${TRIM_PKGVAR}" ]; then
        rm -rf "${TRIM_PKGVAR}"/* 2>/dev/null
    fi
    # 删除共享数据目录（可能为冒号分隔的多个路径）
    if [ -n "${TRIM_DATA_SHARE_PATHS}" ]; then
        echo "${TRIM_DATA_SHARE_PATHS}" | tr ':' '\n' | while read -r p; do
            [ -n "$p" ] && [ -d "$p" ] && rm -rf "${p}"/* 2>/dev/null
        done
    fi
fi

exit 0
